# ===== 环境配置（复制此文件为 .env 并填入真实值） =====

# DeepSeek API 配置
# 从 https://platform.deepseek.com/ 获取 API Key
API_KEY=

# DeepSeek API 地址（无需修改）
BASE_URL=https://api.deepseek.com

# DeepSeek 使用的模型名称；切换 OpenAI 后不会使用此值
# 当前官方模型；Provider 默认使用非思考模式进行工具调用
MODEL=deepseek-flash

# LLM Provider 选择（deepseek / openai / glm / mock）
# deepseek: 使用 DeepSeek API（默认）
# openai: 使用 OpenAI API（需配置 OPENAI_API_KEY）
# glm: 使用智谱 BigModel API（需配置 GLM_API_KEY）
# mock: 模拟模式（不调 API，测试用）
LLM_PROVIDER=deepseek

# Amazon 美国站 FBM 只读订单。店铺 ID 应使用已授权卖家的固定标识。
AMAZON_ORDERS_SHOP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=

# OpenAI 配置（当 LLM_PROVIDER=openai 时使用）
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# 智谱 BigModel 配置（当 LLM_PROVIDER=glm 时使用）
# GLM_API_KEY=
# GLM_MODEL=glm-4.5-air
# LISTING_SIGNIFICANT_DECLINE_PCT=20

# 可选：DeepSeek 独立密钥；API_KEY 非空时优先使用 API_KEY（兼容旧配置）
# DEEPSEEK_API_KEY=

# JWT 签名密钥，部署时生成独立随机值并填入此处。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 计划历史只读聚合产物（由 scripts.import_criteo_metrics 生成）；身份和来源计划映射不接受模型传入。
PLAN_METRICS_DB_PATH=

# 可选：独立知识库的 Chroma 目录
RAG_DB_PATH=

# 可选。设置独立 SQLite 文件以启用诊断暂停沙箱。仅用于演示数据。
DIAGNOSIS_SANDBOX_DB_PATH=
DIAGNOSIS_MYSQL_PAUSE_ENABLED=0

# 商品资料聊天默认用 R4 CPU 召回。设为 0 可回滚到原 CPU 召回。
PRODUCT_R4_CPU_ENABLED=1
# GPU 重排默认关闭。灰度名单填写服务端测试用户 ID 的 JSON 数组。
PRODUCT_RERANK_ENABLED=0
PRODUCT_RERANK_USER_IDS=[]
PRODUCT_RERANK_MAX_CONCURRENCY=1
PRODUCT_RERANK_QUEUE_SIZE=3
PRODUCT_RERANK_QUEUE_TIMEOUT_MS=400
PRODUCT_RERANK_INFERENCE_TIMEOUT_MS=700
