  "plan_sql": "SELECT id, plan_name, status, daily_budget, user_id FROM ad_plans WHERE user_id=? ORDER BY id",
  "alert_sql": "SELECT type, message, level, is_read, user_id FROM alerts WHERE user_id=? ORDER BY id",
  "sql": {
    "window": "-- Independently reconstruct requested window totals and coverage directly from the pinned artifact.\n-- Parameters: source_plan_id, start_date, end_date, excluded_date (NULL in ordinary cases).\nWITH RECURSIVE\nparams(source_plan_id, start_date, end_date, excluded_date) AS (VALUES (?, ?, ?, ?)),\ndays(day) AS (\n    SELECT start_date FROM params\n    UNION ALL\n    SELECT date(day, '+1 day') FROM days, params WHERE day < end_date\n)\nSELECT COUNT(*) AS expected_days,\n       COUNT(m.metric_date) AS observed_days,\n       GROUP_CONCAT(CASE WHEN m.metric_date IS NULL THEN days.day END, ',') AS missing_dates,\n       CASE WHEN COUNT(*) = COUNT(m.metric_date) THEN SUM(m.impressions) END AS impressions,\n       CASE WHEN COUNT(*) = COUNT(m.metric_date) THEN SUM(m.clicks) END AS clicks,\n       CASE WHEN COUNT(*) = COUNT(m.metric_date)\n            THEN 100.0 * SUM(m.clicks) / NULLIF(SUM(m.impressions), 0) END AS ctr_pct\nFROM days CROSS JOIN params p\nLEFT JOIN plan_daily_metrics m ON m.metric_date = days.day\n    AND m.source_plan_id = p.source_plan_id AND days.day IS NOT p.excluded_date;\n",
    "review": "-- Parameters: baseline impressions, current impressions, baseline CTR %, current CTR %,\n-- minimum impressions per window, minimum relative decline %.\nWITH facts(bi, ci, bctr, cctr, min_exp, min_drop) AS (VALUES (?, ?, ?, ?, ?, ?)),\ncomparison AS (\n    SELECT *, 100.0 * (bctr - cctr) / NULLIF(bctr, 0) AS relative_decline_pct FROM facts\n)\nSELECT relative_decline_pct,\n       CASE WHEN relative_decline_pct IS NOT NULL THEN\n           bi >= min_exp AND ci >= min_exp AND relative_decline_pct >= min_drop END AS qualifies\nFROM comparison;\n"
  },
